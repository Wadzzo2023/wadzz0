model RedeemConsumer {
    id         Int      @id @default(autoincrement())
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    code       String
    redeemCode Redeem   @relation(fields: [code], references: [code], onDelete: Cascade)
    redeemedAt DateTime @default(now())
}

model QRItem {
    id           String   @id @default(cuid())
    title        String
    modelUrl     String
    externalLink String?
    startDate    DateTime
    endDate      DateTime
    qrCode       String   @db.Text
    isActive     Boolean  @default(true)
    creatorId    String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    // Relations
    creator      User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    descriptions QRDescription[]
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@unique([id, creatorId])
    @@index([platformId])
}

model QRDescription {
    id       String @id @default(cuid())
    title    String @db.VarChar(50)
    content  String @db.Text
    order    Int
    qrItemId String

    // Relations
    qrItem QRItem @relation(fields: [qrItemId], references: [id], onDelete: Cascade)

    @@unique([qrItemId, order]) // Ensure unique order per QR item
    @@index([qrItemId, order])
}

