// COPY of brand-wadzzo/prisma/schema.prisma — the shared database's source of truth.
// Edit the schema in brand-wadzzo, then copy it here. Never `prisma db push` from this repo.

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
    provider = "postgresql"
    // Prisma 7: the connection URL lives in prisma.config.ts.
}

// ------------------------Generic SCHEMA-------------------------

model Tag {
    name          String          @id
    AdminAssetTag AdminAssetTag[]
}

enum MediaType {
    MUSIC
    VIDEO
    IMAGE
    THREE_D
}

// ------------------------NOTIFICATION SCHEMA-------------------------
enum PinType {
    EVENT
    BOUNTY
    EXPERIENCE
    LAUNCH
    OTHER
    LANDMARK
}

enum NotificationType {
    LIKE
    COMMENT
    SUBSCRIPTION
    POST
    SHOP_ASSET
    FOLLOW
    REPLY
    BOUNTY
    BOUNTY_PARTICIPANT
    BOUNTY_SUBMISSION
    BOUNTY_COMMENT
    BOUNTY_REPLY
    BOUNTY_WINNER
    BOUNTY_DOUBT
    BOUNTY_DOUBT_CREATE
    BOUNTY_DOUBT_REPLY
    // bounty lifecycle (fan side)
    BOUNTY_ENTRY_REVIEWED
    BOUNTY_ENDED
    BOUNTY_CANCELLED
    // commerce and delivery (brand side)
    ITEM_SOLD
    ROYALTY_EARNED
    ITEM_SOLD_OUT
    GIFT_CLAIMED
    PIN_COLLECTED
    // commerce and delivery (fan side)
    ITEM_PURCHASED
    RESALE_SOLD
    GIFT_RECEIVED
}

// it is kinda notification actor and the entity that is being acted upon
// Notification model to track notifications for both users and creators
model Notification {
    id Int @id @default(autoincrement())

    notificationObjectId Int
    notificationObject   NotificationObject @relation(fields: [notificationObjectId], references: [id], onDelete: Cascade)

    seen      DateTime?
    createdAt DateTime  @default(now())

    notifierId String
    isCreator  Boolean @default(false) // Notification for creators if true, for users if false

    // inbox lists and the unread badge
    @@index([notifierId, isCreator, createdAt])
    @@index([notifierId, isCreator, seen])
}

model NotificationObject {
    id           Int              @id @default(autoincrement())
    entityType   NotificationType
    entityId     Int
    createdAt    DateTime         @default(now())
    Notification Notification[]
    actorId      String
    actor        User             @relation(fields: [actorId], references: [id], onDelete: Cascade)
    isUser       Boolean          @default(true)
    /// event details that aren't a row of their own: item name, amount, quantity, currency…
    meta         Json?
}

// ------------------------FAN SCHEMA-------------------------
model Subscription {
    id Int @id @default(autoincrement())

    name        String
    description String   @default("")
    features    String[] // one perk per entry
    /// palette name the UI maps to theme-safe classes: green | blue | purple | gold | rose | slate
    color       String   @default("green")
    popular     Boolean  @default(false)
    isActive    Boolean  @default(true)
    /// page tokens a fan must hold to be in this tier
    price       Float
    createdAt   DateTime @default(now())

    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    posts         Post[]
    assets        Asset[]
    LocationGroup LocationGroup[]
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@unique([name, creatorId])
    @@index([platformId])
}

model Like {
    id        Int      @id @default(autoincrement())
    postId    Int
    post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    status Boolean @default(true)

    @@unique([postId, userId])
}

model Comment {
    id              Int    @id @default(autoincrement())
    parentCommentID Int? // Optional field to reference parent comment (for nested comments)
    postId          Int // Foreign key referencing Post model
    post            Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
    userId          String // Foreign key referencing User model
    user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    content         String // Content of the comment

    // Optional relationship: a comment can have a parent comment
    parentComment Comment? @relation("ChildComments", fields: [parentCommentID], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) // Timestamp when the comment was created

    // Optional field: allows for a comment to have child comments (replies)
    childComments Comment[] @relation("ChildComments") // Collection of child comments (replies)
}

model User_Asset {
    id     Int    @id @default(autoincrement())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    assetId Int
    asset   Asset @relation(fields: [assetId], references: [id], onDelete: NoAction)

    buyAt DateTime @default(now())
}

model Follow {
    id     Int    @id @default(autoincrement())
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    followAt DateTime @default(now())

    // Unique constraint on userId and subscriptionId
    @@unique([userId, creatorId])
}

model Media {
    id   Int       @id @default(autoincrement())
    url  String
    type MediaType

    postId Int
    post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model CreatorPageAsset {
    creatorId String @id

    code          String
    issuer        String
    issuerPrivate String?
    thumbnail     String?
    priceUSD      Float   @default(1)
    price         Float   @default(2)

    limit Int

    creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Creator {
    id                 String   @id
    joinedAt           DateTime @default(now())
    profileUrl         String?
    circularProfileUrl String?
    coverUrl           String?
    bio                String?
    name               String

    backgroundSVG String?
    showSVG       Boolean @default(false)
    vanityURL     String? @unique(map: "unique_vanityurl")

    storagePub    String
    storageSecret String

    aprovalSend         Boolean
    approved            Boolean? // if undefined than it is sended for aproval, false means banned, true means aproved
    notCreatorButSeller Boolean  @default(false) // only for if normal user want to sell or place to market

    // pageAsset
    pageAssetId Int?

    customPageAssetCodeIssuer String? // CODE-ISSUER-ASSET-USD

    extraFields Json? // {navPermission?: true}

    user               User                  @relation(fields: [id], references: [id], onDelete: Cascade)
    posts              Post[]
    subscriptions      Subscription[]
    assets             Asset[]
    marketAssets       MarketAsset[]
    pageAsset          CreatorPageAsset?
    followers          Follow[]
    LocationGroup      LocationGroup[]
    Bounty             Bounty[]
    vanitySubscription VanitySubscription?
    SellPageAsset      SellPageAsset[]
    pinAgentSessions   PinAgentChatSession[] @relation("pinAgentSessions")
    pinAgentMessages   PinAgentChatHistory[] @relation("pinAgentMessages")
    createdAt          DateTime              @default(now())
    hotspots           Hotspot[]
    locationGroupJobs  LocationGroupJob[]
    agentJobs          AgentJob[]
    locationTags       LocationTag[]
    events        CreatorEvent[]
    announcements CreatorAnnouncement[]
    mapEmbeds          MapEmbed[]
    agentConversations AgentConversation[]
    issuer             CreatorIssuer?
    royaltyTransactions AssetTransaction[] @relation("TxCreator")

    // The brand's own home area; overrides its platform's (see Platform.homeArea).
    homeArea     Json?
    homeAreaName String?

    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@index([bio, name])
    @@index([platformId])
}

model VanitySubscription {
    id        String   @id @default(cuid())
    creatorId String   @unique
    creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    startDate DateTime @default(now())
    endDate   DateTime

    // Payment tracking
    lastPaymentAmount Float
    lastPaymentDate   DateTime
}

model Post {
    id Int @id @default(autoincrement())

    content String
    heading String @default("Heading")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    creatorId String

    subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
    subscriptionId Int?
    likes          Like[]
    comments       Comment[]
    medias         Media[]
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@index([heading])
    @@index([platformId])
}

// Necessary for Next auth
model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? // @db.Text
    access_token      String? // @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? // @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?   @unique
    email         String?   @unique
    bio           String?
    coverImage    String?
    pronouns      String?
    image         String?
    emailVerified DateTime?

    firstSignUpMethod String? // e.g. email, google, github, etc.

    joinedAt         DateTime?          @default(now())
    fromAppSignup    Boolean?           @default(false)
    accounts         Account[]
    sessions         Session[]
    creator          Creator?
    likes            Like[]
    comments         Comment[]
    assets           User_Asset[]
    Admin            Admin[]
    followings       Follow[]
    LocationConsumer LocationConsumer[]

    actorNotificationObjects NotificationObject[]
    BountyParticipant        BountyParticipant[]
    BountySubmission         BountySubmission[]
    BountyComment            BountyComment[]
    Bounty                   Bounty[]
    BountyDoubt              BountyDoubt[]
    BountyDoubtMessage       BountyDoubtMessage[]

    BountyWinner BountyWinner[]

    RedeemConsumer RedeemConsumer[]

    QRItem QRItem[]
    eventRsvps           EventRsvp[]
    eventComments        EventComment[]
    announcementComments AnnouncementComment[]

    muralsDiscovered  Mural[]            @relation("MuralDiscoverer")
    muralScans        MuralScan[]
    muralScanSessions MuralScanSession[]
    coinBalances      CoinBalance[] // one per platform
    coinLedger        CoinLedger[]
    purchases         AssetTransaction[] @relation("TxBuyer")
    sales             AssetTransaction[] @relation("TxSeller")
    // platform the user first signed up on; every platform joined is in UserPlatform
    signupPlatformId String         @default("wadzzo")
    signupPlatform   Platform       @relation("SignupPlatform", fields: [signupPlatformId], references: [id])
    platforms        UserPlatform[]
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

enum ItemPrivacy {
    DRAFT
    FOR_SALE
    NOT_FOR_SALE
    PUBLIC
    PRIVATE // only for followers
    TIER // tier based
}

// ------------------------Marketplace SCHEMA-------------------------

model Asset {
    id          Int     @id @default(autoincrement())
    name        String
    description String?

    /// Max copies that may ever exist; null = unlimited. Enforced by the server
    /// when it mints (the issuer stays unlocked so copies can be minted on demand).
    limit Int?
    /// Copies issued on-chain so far (into storage or straight to a buyer/claimer).
    mintedCount Int @default(0)
    /// % of every resale price paid to the creator (0–15).
    royaltyPercent Float @default(0)

    code          String
    issuer        String
    /// Legacy per-asset issuer secret. New assets are issued by the creator's
    /// CreatorIssuer and leave this empty.
    issuerPrivate String?

    mediaType MediaType
    mediaUrl  String
    thumbnail String

    privacy ItemPrivacy @default(PUBLIC)

    creatorId String? // if null then it is admin asset
    creator   Creator? @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    tierId Int?
    tier   Subscription? @relation(fields: [tierId], references: [id], onDelete: SetNull)

    buyers        User_Asset[]
    marketItems   MarketAsset[]
    LocationGroup LocationGroup[]
    Redeem        Redeem[]
    transactions  AssetTransaction[]

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@unique([code, issuer])
    @@index([name, description])
    @@index([platformId])
}

// this will eliminate asset buy modal overhead.
enum MarketType {
    ADMIN
    FAN
}

// this for creators;
model MarketAsset {
    id Int @id @default(autoincrement())

    privacy ItemPrivacy @default(PUBLIC)

    price    Float
    priceUSD Float @default(1)

    type MarketType @default(FAN)

    assetId Int
    asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

    placedAt  DateTime @default(now())
    createdAt DateTime @default(now())

    placerId String? // admin placing this assets
    placer   Creator? @relation(fields: [placerId], references: [id], onDelete: Cascade)

    transactions AssetTransaction[]

    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@unique([assetId, placerId])
    @@index([platformId])
}

/// A creator's Stellar issuer account. One per creator, set up (and paid for by
/// the creator) before their first on-demand asset; every later asset of theirs
/// is issued by it, so new assets cost no issuer account. The secret is kept
/// encrypted (AES-256-GCM, key ISSUER_ENCRYPTION_KEY) and never leaves the server.
model CreatorIssuer {
    creatorId       String   @id
    creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    publicKey       String   @unique
    secretEncrypted String
    /// true once the account exists on-chain
    active          Boolean  @default(false)
    createdAt       DateTime @default(now())
}

enum AssetTxType {
    ISSUER_SETUP // creator opens their issuer account
    STORAGE_SETUP // user opens a storage (resale) account
    MINT_TO_STORAGE // creator mints copies into their own storage
    PURCHASE // fan buys from the creator (from stock or minted on demand)
    RESALE_PURCHASE // fan buys from another fan's resale listing
    PAGE_ASSET_PURCHASE // fan buys a creator's page tokens
    CLAIM // fan claims from a pin (minted on demand if needed)
    GIFT // creator sends a copy to a fan
    LIST // seller moves copies into storage to sell
    UNLIST // seller takes copies back from storage
    TOKEN_PURCHASE // fan buys platform tokens by card
    TOKEN_SWAP // fan swaps platform tokens for XLM
    GIFT_CLAIM // fan accepts a pending (claimable) gift
    TRANSFER // user sends XLM or a token to another address (direct, or as a claimable gift)
}

enum AssetTxStatus {
    PENDING // built, waiting for signature/submission (void after expiresAt)
    SUCCESS
    FAILED
}

enum PaymentMethod {
    PLATFORM_ASSET
    XLM
    CARD
    NONE
}

/// Every on-chain action on an item, with what it cost. Built by the server
/// (status PENDING, hash known before signing), then confirmed against Horizon.
/// Drives activity/transaction history and reserves supply while pending.
model AssetTransaction {
    id     String        @id @default(cuid())
    type   AssetTxType
    status AssetTxStatus @default(PENDING)

    assetId       Int?
    asset         Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
    marketAssetId Int?
    marketAsset   MarketAsset? @relation(fields: [marketAssetId], references: [id], onDelete: SetNull)

    quantity Int @default(1)
    /// copies newly minted by this transaction (counted toward Asset.limit)
    minted   Int @default(0)

    buyerId   String?
    buyer     User?    @relation("TxBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
    sellerId  String?
    seller    User?    @relation("TxSeller", fields: [sellerId], references: [id], onDelete: SetNull)
    /// the item's creator (receives price or royalty)
    creatorId String?
    creator   Creator? @relation("TxCreator", fields: [creatorId], references: [id], onDelete: SetNull)

    method   PaymentMethod @default(NONE)
    /// currency of the amounts below: platform asset code, "XLM" or "USD"
    currency String
    price         Float @default(0)
    royaltyAmount Float @default(0)
    platformFee   Float @default(0)
    networkFee    Float @default(0)
    /// XLM reserves (trustline/account) the payer covered, in `currency`
    reserveCost   Float @default(0)
    total         Float @default(0)

    /// card payment id (Square) when method = CARD; the card is charged before delivery
    paymentRef String?   @unique
    /// Stellar transaction hash (known before signing)
    txHash    String?   @unique
    error     String?
    expiresAt DateTime?

    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([buyerId, createdAt])
    @@index([sellerId, createdAt])
    @@index([assetId, status])
    @@index([platformId])
}

model SellPageAsset {
    id           Int      @id @default(autoincrement())
    title        String
    description  String?
    amountToSell Int
    price        Float
    priceUSD     Float    @default(1)
    priceXLM     Float    @default(0)
    isSold       Boolean  @default(false)
    placedAt     DateTime @default(now())

    placerId String? // admin placing this assets
    placer   Creator?  @relation(fields: [placerId], references: [id], onDelete: Cascade)
    soldAt   DateTime? @default(now())

    @@unique([id, placerId])
}

// ------------------------Wallete SCHEMA-------------------------

model AdminAsset {
    id Int @id @default(autoincrement())

    description String
    link        String
    codeIssuer  String
    code        String

    logoUrl      String
    logoBlueData String?
    color        String

    createdAt   DateTime @default(now())
    // market links
    StellarTerm String?
    StellarX    String?
    Litemint    String?

    adminId String
    admin   Admin  @relation(fields: [adminId], references: [id], onDelete: NoAction)

    tags AdminAssetTag[]
}

model AdminAssetTag {
    id Int @id @default(autoincrement())

    tagName String
    tag     Tag    @relation(fields: [tagName], references: [name], onDelete: Cascade)

    adminAssetId Int
    addminAsset  AdminAsset @relation(fields: [adminAssetId], references: [id], onDelete: Cascade)
}

model Admin {
    id       String   @id
    joinedAt DateTime @default(now())

    profileUrl String?
    coverUrl   String?
    bio        String?
    name       String?

    user       User         @relation(fields: [id], references: [id], onDelete: Cascade)
    AdminAsset AdminAsset[]
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])
    @@index([platformId])
}

// ------------------------Mapping SCHEMA-------------------------
model Hotspot {
    id        String  @id @default(cuid())
    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    // Drop schedule
    dropEveryDays    Int // interval in days between drops
    pinDurationDays  Int // lifetime of each dropped LocationGroup (days)
    hotspotStartDate DateTime // when the first drop fires
    hotspotEndDate   DateTime // after this no new drops

    // Colletion
    autoCollect Boolean @default(false) // if true then it will automatically collect from users when they come in the geo fence, otherwise they need to manually click collect button
    multiPin    Boolean @default(false) // if true then it will drop multiple pins in the geo fence, otherwise it will drop only one pin

    // Geo
    shape   String // "circle" | "square" | "polygon"
    geoJson Json // GeoJSON Feature

    // QStash
    qstashScheduleId String?
    isActive         Boolean  @default(true)
    hidden           Boolean  @default(false)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    locationGroups LocationGroup[]
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])
    @@index([platformId])
}

model LocationTag {
    id        String  @id @default(cuid())
    name      String  @unique
    label     String
    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

    locationGroups LocationGroupTag[]
}

model LocationGroupTag {
    locationGroupId String
    locationGroup   LocationGroup @relation(fields: [locationGroupId], references: [id], onDelete: Cascade)
    tagId           String
    tag             LocationTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([locationGroupId, tagId])
}

model LocationTagCache {
    title     String   @id
    tags      String[]
    createdAt DateTime @default(now())
}

model LocationGroup {
    id String @id @default(cuid())

    privacy ItemPrivacy @default(PUBLIC)

    subscriptionId Int?
    Subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

    assetId Int?
    asset   Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)

    pageAsset Boolean? @default(false)

    creatorId String
    creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    hidden    Boolean @default(false)
    limit     Int     @default(0)
    remaining Int     @default(0)

    title       String
    description String?

    startDate DateTime
    endDate   DateTime

    approved Boolean?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    latitude  Float
    longitude Float
    radius    Float

    image          String?
    optimizedImage String?

    link              String?
    aiUrlDescriptions String[] @default([])

    multiPin Boolean @default(false)
    type     PinType @default(OTHER) // EVENT, LANDMARK, BOUNTY, EXPERIENCE, LAUNCH, OTHER

    locations         Location[]
    hotspot           Hotspot?           @relation(fields: [hotspotId], references: [id])
    hotspotId         String?
    locationGroupTags LocationGroupTag[]
    events CreatorEvent[]
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])
    @@index([platformId])
}

model Location {
    id String @id @default(cuid())

    latitude    Float
    longitude   Float
    hidden      Boolean @default(false)
    autoCollect Boolean

    locationGroupId String?
    locationGroup   LocationGroup? @relation(fields: [locationGroupId], references: [id], onDelete: Cascade)

    consumers LocationConsumer[]
}

model LocationConsumer {
    id String @id @default(cuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    locationId String
    location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
    redeemCode String    @unique
    isRedeemed Boolean   @default(false)
    redeemedAt DateTime?
    claimedAt  DateTime?

    viewedAt DateTime?

    hidden Boolean @default(false)

    createdAt DateTime @default(now())
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])
    @@index([platformId])
}

model Bounty {
    id                 Int                 @id @default(autoincrement())
    title              String
    description        String
    priceInUSD         Float
    priceInBand        Float
    totalWinner        Int
    currentWinnerCount Int                 @default(0)
    priceInXLM         Float?
    requiredBalance    Float
    imageUrls          String[]
    createdAt          DateTime            @default(now())
    endDate            DateTime?
    status             BountyStatus        @default(PENDING)
    creatorId          String
    creator            Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
    participants       BountyParticipant[] // Users who join the bounty
    comments           BountyComment[] // Comments on the bounty
    submissions        BountySubmission[] // Submissions to the bounty
    doubts             BountyDoubt[]
    BountyWinner       BountyWinner[]
    User               User?               @relation(fields: [userId], references: [id])
    userId             String?
    events CreatorEvent[]
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@index([title, description])
    @@index([platformId])
}

model BountyWinner {
    id        Int      @id @default(autoincrement())
    bountyId  Int
    xdr       String?
    isSwaped  Boolean? @default(false)
    bounty    Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    awardedAt DateTime @default(now()) // Timestamp of when the user was awarded as a winner
}

model BountyDoubt {
    id        Int                  @id @default(autoincrement())
    bountyId  Int
    bounty    Bounty               @relation(fields: [bountyId], references: [id], onDelete: Cascade)
    userId    String // The user who asked the doubt
    user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    updatedAt DateTime?            @updatedAt
    createdAt DateTime             @default(now())
    messages  BountyDoubtMessage[] // Relationship for messages between user and creator
}

model BountyDoubtMessage {
    id        Int         @id @default(autoincrement())
    doubtId   Int
    doubt     BountyDoubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
    senderId  String
    sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
    role      UserRole    @default(USER)
    content   String
    createdAt DateTime    @default(now())
    updatedAt DateTime?   @updatedAt
}

enum UserRole {
    USER
    CREATOR
}

model BountyParticipant {
    id       Int    @id @default(autoincrement())
    bountyId Int
    bounty   Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    joinedAt DateTime @default(now())
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
    platform   Platform @relation(fields: [platformId], references: [id])

    @@unique([bountyId, userId])
    @@index([platformId])
}

model BountySubmission {
    id        Int                    @id @default(autoincrement())
    bountyId  Int
    bounty    Bounty                 @relation(fields: [bountyId], references: [id], onDelete: Cascade)
    userId    String
    user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    content   String
    medias    SubmissionAttachment[]
    createdAt DateTime               @default(now())
    status    SubmissionViewType     @default(UNCHECKED)
}

model SubmissionAttachment {
    id           Int              @id @default(autoincrement())
    submissionId Int
    submission   BountySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade) // Add this relation field
    url          String
    name         String
    size         Int
    type         String
    createdAt    DateTime         @default(now())
}

model BountyComment {
    id                    Int    @id @default(autoincrement())
    bountyParentCommentID Int?
    bountyId              Int
    bounty                Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
    userId                String
    user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    content               String

    bountyParentBComment BountyComment? @relation("ChildBountyComments", fields: [bountyParentCommentID], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    bountyChildComments BountyComment[] @relation("ChildBountyComments")
}

enum BountyStatus {
    PENDING
    APPROVED
    REJECTED
}

enum SubmissionViewType {
    UNCHECKED
    CHECKED
    ONREVIEW
    APPROVED
    REJECTED
}

// I want to add asset redeeming feature

model Redeem {
    code            String           @id
    totalRedeemable Int
    redeemConsumers RedeemConsumer[]
    assetRedeemId   Int
    assetRedeem     Asset            @relation(fields: [assetRedeemId], references: [id], onDelete: Cascade)
    // white-label platform this row belongs to (see model Platform)
    platformId String   @default("wadzzo")
